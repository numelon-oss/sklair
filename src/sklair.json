{
	"hooks": {
		"enabled": true,
		"path": "./hooks"
	},

	"input": "./",
	"components": "./components",
	"layouts": "./layouts",

	"exclude": [
		".*",
		"!.htaccess",
		"*.md",
		"*.psd",
		"/schema",
		"/docs/navigation.json",
		"/docs/config.json"
	],
	"exclude_compile": ["someBigFile.html"],

	"output": "./build",

	"minify": true,
	"obfuscateJS": {
		"enabled": true
	},

	"preventFOUC": {
		"enabled": false,
		"colour": "#24100a"
	},

	"templates": ["DocumentationSearchResult"]
}
